SECRET_KEY=change-this-to-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key-here
DEBUG=true

# Local SQLite (default)
DATABASE_URL=sqlite:///workouts.db

# PostgreSQL (use this for Vercel — get a free DB at neon.tech)
# DATABASE_URL=postgresql://user:password@host/dbname
# Vercel Postgres also exposes POSTGRES_URL / POSTGRES_URL_NON_POOLING
# POSTGRES_URL=postgres://user:password@host/dbname
